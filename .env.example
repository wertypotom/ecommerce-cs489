# Copy to `.env` (same directory as docker-compose.yml) to override defaults.
# Every value below is already the default, so this file is optional.

# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=ecommerce_db

# --- Backend ---
JWT_SECRET=Y29tLWVjb21tZXJjZS1zZWNyZXQta2V5LWZvci1qd3QtdG9rZW4tZ2VuZXJhdGlvbi1hdC1sZWFzdC0yNTYtYml0cw==

# Uncomment to point the containerised backend at a database outside compose:
# DB_URL=jdbc:postgresql://localhost:5432/ecommerce_db
# DB_USERNAME=admin
# DB_PASSWORD=secretpassword

# --- Frontend ---
# BACKEND_URL is set to http://backend:8085 in docker-compose.yml and normally
# needs no override. It must be a bare origin with no trailing slash.
